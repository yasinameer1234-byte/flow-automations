# Copy to .env (git-ignored) and fill in locally. NEVER commit .env.
# --- Core ---
FLOW_DB_PATH=var/flow.db
FLOW_TENANT_CONFIG=config/tenants/demo.toml
FLOW_LOG_LEVEL=INFO
FLOW_LOG_JSON=true
FLOW_RETRY_ATTEMPTS=4
FLOW_RETRY_BASE_DELAY=0.5

# --- AI ---
# simulated = deterministic local classifier (no network, no cost)
# anthropic = Claude API (needs ANTHROPIC_API_KEY; costs money per call)
FLOW_AI_PROVIDER=simulated
FLOW_AI_MODEL=claude-opus-5-5
FLOW_AI_EFFORT=low
# ANTHROPIC_API_KEY=   <- set in your shell or secret manager, not here in a committed file

# --- Integrations (all simulated in v0.1) ---
FLOW_EMAIL_PROVIDER=simulated
